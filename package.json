    "imask": "^7.6.1",
    "lucide-react": "^0.274.0",
    "next": "15.3.3",
    "next-themes": "^0.2.1",
    "nodemailer": "^6.9.7",
    "postcss": "8.4.27",
    "postgres": "^3.4.5",
    "puppeteer-core": "^24.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-email": "1.10.1",
    "react-hook-form": "^7.47.0",
    "react-icons": "^4.10.1",
    "react-imask": "^7.6.1",
