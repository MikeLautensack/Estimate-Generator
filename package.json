    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.2.5",
    "puppeteer": "^24.14.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "@mui/x-data-grid": {
      "@mui/material": "$@mui/material"
    },
    "@mui/x-charts": {
      "@mui/material": "$@mui/material"
    },
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5"
  }
