    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@uploadthing/react": "^7.0.3",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "autoprefixer": "10.4.14",
    "bcrypt": "^5.1.1",
